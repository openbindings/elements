{
  "name": "openbindings-elements-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm -r build && pnpm -r check",
    "test": "vitest run && node scripts/check-design-assets.mjs",
    "test:browser": "playwright test",
    "test:ob-start": "playwright test --config=playwright.ob-start.config.ts",
    "test:journeys": "playwright test --config=playwright.journeys.config.ts",
    "gallery": "playwright test --config=playwright.gallery.config.ts",
    "design:gates": "node scripts/design-gates.mjs",
    "parity:gates": "node scripts/parity-gates.mjs",
    "loop:status": "node scripts/loop-status.mjs",
    "test:all": "pnpm test && pnpm test:browser && pnpm test:ob-start",
    "pack:verify": "node scripts/verify-packed-packages.mjs",
    "browser:imports": "node scripts/verify-browser-imports.mjs",
    "ssr:imports": "node scripts/verify-ssr-imports.mjs",
    "sync:requirements": "node scripts/sync-requirements.mjs",
    "build:workbench": "pnpm --filter @openbindings/ob-start-workbench... build"
  },
  "devDependencies": {
    "@openbindings/sdk": "link:../openbindings-ts/packages/sdk",
    "@playwright/test": "^1.59.1",
    "@types/node": "^22.19.17",
    "esbuild": "^0.28.1",
    "jsdom": "^29.0.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.3"
  }
}
