{
  "name": "@openbindings/operation-workbench",
  "version": "0.1.0",
  "description": "Framework-neutral OpenBindings invocation workbench element",
  "type": "module",
  "sideEffects": [
    "./dist/define.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./define": {
      "types": "./dist/define.d.ts",
      "default": "./dist/define.js"
    },
    "./requirement": {
      "types": "./dist/requirement.d.ts",
      "default": "./dist/requirement.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/define.ts src/requirement.ts --format esm --dts --clean",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@openbindings/ui-core": "workspace:^",
    "@openbindings/json-editor": "workspace:^"
  },
  "peerDependencies": {
    "@openbindings/sdk": "^0.2.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/openbindings/elements.git",
    "directory": "packages/operation-workbench"
  }
}
